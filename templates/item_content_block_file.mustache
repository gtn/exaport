{{#hasheading}}<h5 class="exaport-item-block__title">{{heading}}</h5>{{/hasheading}}
{{#hascontent}}<div class="exaport-item-block__content">{{{contenthtml}}}</div>{{/hascontent}}
{{#hasfiles}}
<div class="exaport-item-block__files">
    {{#files}}
    <div class="exaport-item-block__file">
        {{#isimage}}
        <a class="exaport-item-block__image-link" href="{{url}}">
            <img class="img-fluid rounded border" src="{{url}}" alt="" loading="lazy">
        </a>
        {{/isimage}}
        <div class="exaport-item-block__file-meta">
            {{^isimage}}<a href="{{url}}">{{name}}</a>{{/isimage}}
            {{#isimage}}{{name}}{{/isimage}}
            <span class="text-muted">({{size}})</span>
        </div>
    </div>
    {{/files}}
</div>
{{/hasfiles}}
{{^hasfiles}}<p class="text-muted mb-0">{{emptyfiletext}}</p>{{/hasfiles}}
