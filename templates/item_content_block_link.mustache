{{#hasheading}}
<div class="exaport-item-block__header">
    <h5 class="exaport-item-block__title">{{heading}}</h5>
    {{#canedit}}<a class="btn btn-link btn-sm p-0" href="{{editurl}}" aria-label="{{editlabel}}" title="{{editlabel}}">{{#str}}edit, core{{/str}}</a>{{/canedit}}
    {{#candelete}}<a class="btn btn-link btn-sm text-danger p-0" href="{{deleteurl}}" aria-label="{{deletelabel}}" title="{{deletelabel}}">{{#str}}delete, core{{/str}}</a>{{/candelete}}
</div>
{{/hasheading}}
{{^hasheading}}
<div class="exaport-item-block__header exaport-item-block__header--actions-only">
    {{#canedit}}<a class="btn btn-link btn-sm p-0" href="{{editurl}}" aria-label="{{editlabel}}" title="{{editlabel}}">{{#str}}edit, core{{/str}}</a>{{/canedit}}
    {{#candelete}}<a class="btn btn-link btn-sm text-danger p-0" href="{{deleteurl}}" aria-label="{{deletelabel}}" title="{{deletelabel}}">{{#str}}delete, core{{/str}}</a>{{/candelete}}
</div>
{{/hasheading}}
{{#hasurl}}
<p class="mb-2">
    <a href="{{url}}">{{linktext}}</a>
</p>
{{/hasurl}}
{{^hasurl}}<p class="text-muted mb-2">{{emptylinktext}}</p>{{/hasurl}}
{{#hascontent}}<div class="exaport-item-block__content">{{{contenthtml}}}</div>{{/hascontent}}
