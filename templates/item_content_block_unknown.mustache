{{#hasheading}}
<div class="exaport-item-block__header">
    <h5 class="exaport-item-block__title">{{heading}}</h5>
    <div class="exaport-item-block__actions" role="group" aria-label="{{actionslabel}}">
    {{#candelete}}
        <form class="d-inline" method="post" action="{{deleteposturl}}">
            <input type="hidden" name="courseid" value="{{deletecourseid}}">
            <input type="hidden" name="itemid" value="{{deleteitemid}}">
            <input type="hidden" name="blockid" value="{{deleteblockid}}">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="backtype" value="{{deletebacktype}}">
            <input type="hidden" name="sesskey" value="{{deletesesskey}}">
            <button class="btn btn-link btn-sm text-danger p-0" type="submit" aria-label="{{deletelabel}}" title="{{deletelabel}}">{{#str}}delete, core{{/str}}</button>
        </form>
    {{/candelete}}
    </div>
</div>
{{/hasheading}}
