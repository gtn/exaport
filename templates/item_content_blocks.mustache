{{!
    Shared content section for saved items and the pending item editor.
}}
<section class="exaport-item-content-section mt-4 mb-4"
    {{#showheading}}aria-labelledby="exaport-item-content-heading"{{/showheading}}
    {{^showheading}}aria-label="{{heading}}"{{/showheading}}>
    {{#showheading}}
    <h2 id="exaport-item-content-heading" class="h4 mb-3">{{heading}}</h2>
    {{/showheading}}
    <div class="exaport-item-content-rows border-top" {{^hasblocks}}hidden{{/hasblocks}}>
        {{#blocks}}
        {{> block_exaport/item_content_row}}
        {{/blocks}}
    </div>
    {{#showaddbutton}}
    <div class="d-flex justify-content-center align-items-center my-3 exaport-item-content-divider">
        <hr class="flex-grow-1 m-0" aria-hidden="true">
        <div class="px-3">
            {{#hasaddactions}}
            <div class="dropdown">
                <button class="btn btn-secondary exaport-item-content-add-button d-flex justify-content-center align-items-center p-1 icon-no-margin"
                   type="button"
                   data-toggle="dropdown"
                   data-bs-toggle="dropdown"
                   aria-haspopup="true"
                   aria-expanded="false"
                   aria-label="{{addlabel}}"
                   title="{{addlabel}}">
                    {{{addicon}}}
                </button>
                <div class="dropdown-menu">
                    {{#addactions}}
                    <a class="dropdown-item exaport-item-content-add" href="{{url}}"
                       data-content-type="{{type}}" data-content-url="{{url}}">{{{icon}}} <span>{{label}}</span></a>
                    {{/addactions}}
                </div>
            </div>
            {{/hasaddactions}}
            {{^hasaddactions}}
            <span class="btn btn-secondary exaport-item-content-add-button d-flex justify-content-center align-items-center p-1 icon-no-margin disabled"
                  aria-disabled="true"
                  aria-label="{{addlabel}}">
                {{{addicon}}}
            </span>
            {{/hasaddactions}}
        </div>
        <hr class="flex-grow-1 m-0" aria-hidden="true">
    </div>
    {{/showaddbutton}}
</section>
