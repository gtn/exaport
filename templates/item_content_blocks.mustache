{{!
    Read-only ordered content blocks shown for an Exaport item.
}}
<section class="exaport-item-content-section mt-4"
    {{#showheading}}aria-labelledby="exaport-item-content-heading"{{/showheading}}
    {{^showheading}}aria-label="{{heading}}"{{/showheading}}>
    {{#showheading}}
    <h2 id="exaport-item-content-heading" class="h4 mb-3">{{heading}}</h2>
    {{/showheading}}
    {{#hasblocks}}
    <div class="exaport-item-content-rows border-top">
        {{#blocks}}
        <div class="exaport-item-content-row d-flex align-items-start py-3 border-bottom">
            <div class="exaport-item-content-icon flex-shrink-0 me-3">
                {{{icon}}}
            </div>
            <div class="flex-grow-1 text-break">
                <div class="d-flex flex-wrap align-items-baseline gap-2">
                    <span class="exaport-item-content-type text-muted small">{{typelabel}}</span>
                    {{#title}}<span class="exaport-item-content-title fw-semibold">{{title}}</span>{{/title}}
                </div>
                {{#content}}<div class="exaport-item-content-preview mt-1">{{{content}}}</div>{{/content}}
                {{#linkurl}}
                <div class="exaport-item-content-preview mt-1">
                    <a href="{{linkurl}}" target="_blank" rel="noopener noreferrer">{{linkurl}}</a>
                </div>
                {{/linkurl}}
                {{^linkurl}}{{#preview}}<div class="exaport-item-content-preview mt-1">{{preview}}</div>{{/preview}}{{/linkurl}}
                {{#hasfiles}}
                <div class="exaport-item-content-files d-flex flex-wrap gap-3 mt-2">
                    {{#files}}
                    <a href="{{url}}" class="exaport-item-content-file" target="_blank" rel="noopener noreferrer">
                        {{#isimage}}<img src="{{url}}" alt="{{name}}" class="exaport-item-content-thumbnail">{{/isimage}}
                        {{^isimage}}{{{icon}}}<span>{{name}}</span>{{/isimage}}
                    </a>
                    {{/files}}
                </div>
                {{/hasfiles}}
            </div>
        </div>
        {{/blocks}}
    </div>
    {{/hasblocks}}
    {{#showaddbutton}}
    <div class="exaport-item-content-divider">
        {{#hasaddactions}}
        <div class="dropdown">
        <button class="btn add-content exaport-item-content-add-button d-flex justify-content-center align-items-center p-1 icon-no-margin"
           type="button"
           data-toggle="dropdown"
           data-bs-toggle="dropdown"
           data-action="open-addingcontent"
           aria-haspopup="true"
           aria-expanded="false"
           aria-label="{{addlabel}}"
           title="{{addlabel}}">
            {{{addicon}}}
        </button>
        <div class="dropdown-menu">
            {{#addactions}}
            <a class="dropdown-item" href="{{url}}">{{{icon}}} <span>{{label}}</span></a>
            {{/addactions}}
        </div>
        </div>
        {{/hasaddactions}}
        {{^hasaddactions}}
        <span class="exaport-item-content-add-button"
              aria-disabled="true"
              aria-label="{{addlabel}}">
            {{{addicon}}}
        </span>
        {{/hasaddactions}}
    </div>
    {{/showaddbutton}}
</section>
