{{!
    @template block_exaport/share_filter_controls

    Shared search, sort and type controls, with discovery options for incoming shares.
}}
{{#hasrows}}
{{#searchcontrols}}
    <div data-region="exaport-share-filters" class="mb-3">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            {{{searchcontrols}}}
            {{#hassenders}}
                <div style="min-width: 160px; max-width: 250px;">
                    <label class="sr-only" for="exaport-share-sender">{{#str}} share_filter_shared_by, block_exaport {{/str}}</label>
                    <select class="form-control custom-select" id="exaport-share-sender" data-share-filter="userid">
                        <option value="">{{#str}} share_filter_search_user, block_exaport {{/str}}</option>
                        {{#senders}}
                            <option value="{{id}}">{{name}}</option>
                        {{/senders}}
                    </select>
                </div>
                {{#hascourseoptions}}
                    <div style="min-width: 160px; max-width: 250px;">
                        <label class="sr-only" for="exaport-share-course">{{#str}} course {{/str}}</label>
                        <select class="form-control custom-select" id="exaport-share-course" data-share-filter="course">
                            <option value="">{{#str}} share_filter_search_course, block_exaport {{/str}}</option>
                            {{#courseoptions}}
                                <option value="{{id}}">{{name}}</option>
                            {{/courseoptions}}
                        </select>
                    </div>
                {{/hascourseoptions}}
            {{/hassenders}}
            {{^hassenders}}
                <button type="button" class="btn btn-secondary" data-action="clear-filters" hidden>
                    {{#str}} clearAllFilers, block_exaport {{/str}}
                </button>
            {{/hassenders}}
        </div>
        {{#hassenders}}
            <div class="d-flex flex-column">
                <div class="d-flex flex-wrap align-items-center gap-1">
                    <div class="d-flex flex-wrap gap-1" data-region="sender-filter-chips"
                         data-remove-label="{{#str}} remove {{/str}}"></div>
                    <button type="button" class="badge bg-primary text-light border-0 m-1 exaport-clear-filters-chip"
                            data-action="clear-senders" hidden>
                        {{#str}} share_filter_clear_users, block_exaport {{/str}}
                    </button>
                </div>
                {{#hascourseoptions}}
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <div class="d-flex flex-wrap gap-1" data-region="course-filter-chips"
                             data-remove-label="{{#str}} remove {{/str}}"></div>
                        <button type="button" class="badge bg-primary text-light border-0 m-1 exaport-clear-filters-chip"
                                data-action="clear-courses" hidden>
                            {{#str}} share_filter_clear_courses, block_exaport {{/str}}
                        </button>
                    </div>
                {{/hascourseoptions}}
            </div>
            <div class="mt-2 d-flex align-items-center">
                <label class="mb-0 font-weight-normal fw-normal">
                    <input type="checkbox" id="exaport-group-by-sender"{{#groupbysender}} checked{{/groupbysender}}>
                    {{#str}} share_filter_group_by_sender, block_exaport {{/str}}
                </label>
            </div>
        {{/hassenders}}
        <div role="status">
            <p class="mt-3 mb-0" data-region="no-matching-shares" hidden>
                {{#str}} share_filter_no_matches, block_exaport {{/str}}
            </p>
        </div>
    </div>
{{/searchcontrols}}
{{/hasrows}}
