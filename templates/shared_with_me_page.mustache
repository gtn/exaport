{{!
    @template block_exaport/shared_with_me_page

    Overview table of items/categories/views that other users have shared with
    the current user, either directly or via a group/cohort share.

    Context variables:
        hasrows           - Boolean: at least one share row
        rows              - List of rows:
                               typeicon (pre-rendered HTML), typelabel, title, titlenamelower, entitytype, timemodified,
                              url, entityid, ownerid, ownername, coursename, categorycourseid, ownercourseids, updateddate,
                              sharemodetext, sharetooltip, hastooltip, commentcount, hascomments,
                              copyform (optional POST fields: url, sesskey, courseid, categoryid)
        nothingtext       - Localised text shown when nothing is shared with the user
        columns           - Localised column labels and their sort fields, in display order
        searchcontrols    - Pre-rendered HTML for the filter controls
        groupbysender     - Saved display preference for grouping rows by sender
        hassenders, senders, hascourseoptions, courseoptions - Available discovery options
        hascopyactions    - Whether to show the optional actions column
        copycategory      - Localised copy action label
}}
<div class="block_exaport_shared_with_me">
    {{> block_exaport/share_filter_controls }}
    {{^hasrows}}
        <p>{{nothingtext}}</p>
    {{/hasrows}}
    {{#hasrows}}
        <div class="table-responsive">
            <table class="generaltable table table-striped table-hover exaport-share-overview-table"
                   style="width: 100%;" data-region="incoming-shares-table"
                   data-other-courses="{{#str}} othercourses, block_exaport {{/str}}">
                <thead>
                    <tr>
                        {{#columns}}
                            <th scope="col">
                                <button type="button"
                                        class="exaport-sort-heading btn btn-link p-0 align-baseline font-weight-bold fw-bold"
                                        data-sort-field="{{sortfield}}">
                                    {{label}} <span class="exaport-sort-arrow" aria-hidden="true"></span>
                                </button>
                            </th>
                        {{/columns}}
                        {{#hascopyactions}}
                            <th scope="col" class="text-nowrap">{{#str}} actions {{/str}}</th>
                        {{/hascopyactions}}
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr class="exaport-flat-item"
                            data-item-name="{{titlenamelower}}"
                            data-item-date="{{timemodified}}"
                            data-item-type="{{typelabel}}"
                            data-entry-type="{{entitytype}}"
                            data-entry-id="{{entityid}}"
                            data-owner-id="{{ownerid}}"
                            data-owner-name="{{ownername}}"
                            data-course-name="{{coursename}}"
                            data-category-course-id="{{categorycourseid}}"
                            data-owner-course-ids="{{ownercourseids}}"
                            data-shared-with="{{sharemodetext}}"
                            data-comment-count="{{commentcount}}">
                            <td><a href="{{url}}">{{title}}</a></td>
                            <td>{{{typeicon}}}&nbsp;{{typelabel}}</td>
                            <td>{{ownername}}</td>
                            <td>{{coursename}}</td>
                            <td>{{updateddate}}</td>
                            <td>
                                {{#hastooltip}}
                                <span data-bs-toggle="tooltip"
                                      data-bs-html="true"
                                      data-bs-title="{{sharetooltip}}"
                                      data-toggle="tooltip"
                                      data-html="true"
                                      data-title="{{sharetooltip}}">
                                    {{sharemodetext}}
                                </span>
                                {{/hastooltip}}
                                {{^hastooltip}}{{sharemodetext}}{{/hastooltip}}
                            </td>
                            <td>{{#hascomments}}{{commentcount}}{{/hascomments}}</td>
                            {{#hascopyactions}}
                                <td>
                                    {{#copyform}}
                                        <form action="{{url}}" method="post" class="m-0">
                                            <input type="hidden" name="action" value="copy">
                                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                                            <input type="hidden" name="courseid" value="{{courseid}}">
                                            <input type="hidden" name="categoryid" value="{{categoryid}}">
                                            <button type="submit" class="btn btn-secondary btn-sm text-nowrap"
                                                    aria-label="{{copycategory}}: {{title}}">{{copycategory}}</button>
                                        </form>
                                    {{/copyform}}
                                </td>
                            {{/hascopyactions}}
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
</div>
