{{!
    View (collection) card for the bootstrap layout (moodle_bootstrap).
    Rendered as a stacked-paper card via .card-view modifier class.
    Used by block_exaport_view_list_item() in view_items.php.

    Context variables:
        url             - URL to the shared view page
        viewnamelower   - Lowercase view name for data-item-name attribute
        timemodified    - Unix timestamp for data-item-date attribute
        catids          - Comma-separated category IDs for data-category-ids attribute
        viewid          - Integer view id
        collectionicon  - Pre-rendered HTML for the collection/layer icon (with tooltip)
        viewname        - Display name of the view (auto-escaped by mustache)
        ellipsisicon    - Pre-rendered HTML for the "⋮" dropdown toggle icon
        canedit         - Boolean: show "Edit" menu entry
        editurl         - URL for the edit action
        editicon        - Pre-rendered HTML for the edit icon
        editlabel       - Localised "Edit" label
        candelete       - Boolean: show "Delete" menu entry
        deleteurl       - URL for the delete action
        deleteicon      - Pre-rendered HTML for the delete icon
        deletelabel     - Localised "Delete" label
        dateformatted   - Human-readable date string for the card footer
        isshared        - Boolean: view is shared with someone
        sharedicon      - Pre-rendered HTML for the share icon (with tooltip)
        categorybadges  - Pre-rendered HTML for category badge pills (flat mode only, may be empty)
}}
<div class="col mb-4 exaport-flat-item"
     data-entry-type="view"
     data-item-name="{{viewnamelower}}"
     data-item-date="{{timemodified}}"
     data-category-ids="{{catids}}">
    <div class="card card-eportfolio card-view h-100 excomdos_tile excomdos_tile_item id-{{viewid}}">
        <div class="card-top d-flex justify-content-between">
            <h5 class="card-title">
                <a href="{{url}}">{{{collectionicon}}}{{viewname}}</a>
            </h5>
            <span class="eportfolio-card-more">
                <a class="dropdown-toggle" href="#" role="button" data-toggle="dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    {{{ellipsisicon}}}
                </a>
                <ul class="dropdown-menu dropdown-menu-right dropdown-menu-end">
                    {{#canedit}}
                    <li>
                        <a class="dropdown-item" href="{{editurl}}">{{{editicon}}} {{editlabel}}</a>
                    </li>
                    {{/canedit}}
                    {{#candelete}}
                    <li>
                        <a class="dropdown-item" href="{{deleteurl}}">{{{deleteicon}}} {{deletelabel}}</a>
                    </li>
                    {{/candelete}}
                </ul>
            </span>
        </div>
        <div class="card-body position-relative">
            <a href="{{url}}" class="stretched-link" aria-hidden="true" tabindex="-1"></a>
            <div class="card-body-text"></div>
            {{#categorybadges}}
            <div class="card-body-chips">
                {{{categorybadges}}}
            </div>
            {{/categorybadges}}
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="eportoflio-date">{{dateformatted}}</span>
            <div>
                {{#isshared}}
                <span class="eportoflio-shared me-2">
                    {{{sharedicon}}}
                </span>
                {{/isshared}}
            </div>
        </div>
    </div>
</div>
